[Unit]
Description=Quickshell desktop shell
Documentation=https://quickshell.org/
# Matches how the packaged hypridle/hyprpaper units attach to the session:
# started by graphical-session.target, and stopped with it. uwsm is what
# activates that target -- see docs/hyprland-startup.md.
PartOf=graphical-session.target
After=graphical-session.target
# Five restarts in a minute means the config is broken rather than unlucky, so
# stop instead of spinning and let `systemctl --user status` show it.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
# Quickshell's own file watcher is on, which is the default: writing to the QML
# under default/quickshell reloads the shell in place. Nothing sets
# QS_DISABLE_FILE_WATCHER here, and setting it to 0 would not turn the watcher
# back on -- quickshell tests whether the variable is set, not what it says.
#
# It used to be set, and the reason it was is still true: handaan-update pulls
# into this very tree, so a reload can land against a half-written config. What
# changed is the weight given to that. A failed reload keeps the generation
# that is already running and reports the error rather than tearing the session
# down, the next complete write reloads it correctly, and the unit restarts on
# failure if it does come apart -- against which the bar being editable without
# a restart in the loop is worth more than the window it closes.
#
# A restart is still required, not merely tidier, after adding a new QML type
# or singleton: the type registry is built once at launch, so a hot reload does
# not rescan for new registrations.
ExecStart=/usr/bin/quickshell --no-duplicate -p %h/.local/share/handaan/default/quickshell
Restart=on-failure
RestartSec=1s
Slice=session.slice

[Install]
WantedBy=graphical-session.target
