# Single source of truth for HANDAAN_PATH and the PATH entries that depend on it.
#
# Sourced by every entry point that needs the environment set:
#
#   /etc/profile.d/handaan.sh        every login shell, whatever the shell is
#   ~/.config/uwsm/env               the Hyprland session (uwsm inherits no shell PATH)
#   install.sh                       the bootstrap, before anything else runs
#
# handaan writes the first three. A shell that reads none of them has to source
# this file itself: a non-login interactive shell is the case that matters, and
# it is why the zsh setup handaan handed to the user still sources this from
# ~/.zshenv. Wiring only that one is not enough, and fails quietly --
# a bash login, an ssh command, or a TTY session opened before a `chsh` took
# effect all come up without $HANDAAN_PATH/bin on PATH, so handaan-* is simply
# "command not found" on a machine that is otherwise installed correctly.
#
# POSIX sh on purpose: zsh, bash and the uwsm env loader all read this file.
# Idempotent -- safe to source more than once in the same shell.

# /etc/handaan.conf is how a checkout somewhere other than the default path
# announces itself. Nothing writes it today; it is the seam that makes moving
# the tree to /usr/share/handaan a one-file change rather than a grep.
if [ -r /etc/handaan.conf ]; then
    . /etc/handaan.conf
fi

: "${HANDAAN_PATH:=$HOME/.local/share/handaan}"
export HANDAAN_PATH

: "${HANDAAN_STATE:=${XDG_STATE_HOME:-$HOME/.local/state}/handaan}"
export HANDAAN_STATE

case ":$PATH:" in
    *":$HANDAAN_PATH/bin:"*) ;;
    *) PATH="$HANDAAN_PATH/bin:$PATH" ;;
esac
export PATH

# Colours for the terminal apps that can only be pointed at a file from the
# environment; handaan-theme-render writes both files. See ADR 0009.
#
# nmtui, and anything else drawn with newt. A missing file is simply ignored.
: "${NEWT_COLORS_FILE:=$HANDAAN_STATE/theme/newt-colors}"
export NEWT_COLORS_FILE

# lazygit reads a list of config files, later ones winning, so the colours go
# first and your own config.yml after them. But lazygit refuses to start when
# any file on the list is missing, so each is listed only while it exists --
# checked again every time this is sourced, which a new shell does. A list you
# set yourself, one not starting with handaan's file, is left alone.
handaan_lazygit_theme="$HANDAAN_STATE/theme/lazygit.yml"
case "${LG_CONFIG_FILE:-}" in
    "" | "$handaan_lazygit_theme" | "$handaan_lazygit_theme",*)
        handaan_lazygit_user="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit/config.yml"
        if [ -r "$handaan_lazygit_theme" ] && [ -r "$handaan_lazygit_user" ]; then
            LG_CONFIG_FILE="$handaan_lazygit_theme,$handaan_lazygit_user"
            export LG_CONFIG_FILE
        elif [ -r "$handaan_lazygit_theme" ]; then
            LG_CONFIG_FILE="$handaan_lazygit_theme"
            export LG_CONFIG_FILE
        else
            unset LG_CONFIG_FILE
        fi
        unset handaan_lazygit_user
        ;;
esac
unset handaan_lazygit_theme
