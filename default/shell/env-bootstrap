# Single source of truth for HANDAAN_PATH and the PATH entries that depend on it.
#
# Sourced by every entry point that needs the environment set:
#
#   /etc/profile.d/handaan.sh        every login shell, zsh and bash alike
#   ~/.zshenv                        interactive and non-interactive zsh
#   ~/.config/uwsm/env               the Hyprland session (uwsm inherits no shell PATH)
#   install.sh                       the bootstrap, before anything else runs
#
# Wiring only ~/.zshenv is not enough, and fails quietly: a bash login, an ssh
# command, or a TTY session opened before `chsh` took effect all come up without
# $HANDAAN_PATH/bin on PATH, so handaan-* is simply "command not found" on a
# machine that is otherwise installed correctly.
#
# POSIX sh on purpose: zsh, bash and the uwsm env loader all read this file.
# Idempotent -- safe to source more than once in the same shell.

# /etc/handaan.conf is how a checkout somewhere other than the default path
# announces itself. Nothing writes it today; it is the seam that makes moving
# the tree to /usr/share/handaan a one-file change rather than a grep.
if [ -r /etc/handaan.conf ]; then
    . /etc/handaan.conf
fi

: "${HANDAAN_PATH:=$HOME/.local/share/handaan}"
export HANDAAN_PATH

: "${HANDAAN_STATE:=${XDG_STATE_HOME:-$HOME/.local/state}/handaan}"
export HANDAAN_STATE

case ":$PATH:" in
    *":$HANDAAN_PATH/bin:"*) ;;
    *) PATH="$HANDAAN_PATH/bin:$PATH" ;;
esac
export PATH
