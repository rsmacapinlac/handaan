#!/usr/bin/env bash
# handaan:summary=Show which seeded config files have drifted from the handaan defaults.
# handaan:args=[config-path]
# handaan:hidden=config-drift tooling, not core to running handaan
#
# The cost of the copy model is that an edit to ~/.config no longer lands in
# git on its own. This is how drift stays visible instead of being discovered
# on the next rebuild, when it is gone.

set -euo pipefail

: "${HANDAAN_PATH:=$HOME/.local/share/handaan}"
root="$HANDAAN_PATH/config"

report() {
    local rel=$1 default="$root/$1" user="$HOME/.config/$1"
    if [[ ! -e $user ]]; then
        printf '\033[1;33m  missing\033[0m  %s\n' "$rel"
    elif ! cmp -s "$default" "$user"; then
        printf '\033[0;31m  drifted\033[0m  %s\n' "$rel"
    fi
}

if [[ -n ${1:-} ]]; then
    diff -u "$root/$1" "$HOME/.config/$1"
    exit $?
fi

echo "Comparing ~/.config against $root"
while IFS= read -r -d '' file; do
    report "${file#"$root/"}"
done < <(find "$root" -type f -print0 | sort -z)
echo
echo "Take a default:    handaan-refresh-config <path>"
echo "Keep your version: handaan-promote-config <path>"
