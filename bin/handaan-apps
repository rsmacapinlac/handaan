#!/usr/bin/env bash
# handaan:summary=Open the application installer.
# handaan:hidden=installs apps, not handaan itself; see docs/standards/core-stays-minimal.md
#
# The installer is a Quickshell surface -- default/quickshell/Ui/Installer.qml,
# summoned through the AppCatalog singleton's IPC target. This is the CLI door
# to it and does nothing else. The pieces behind it are each their own command:
#
#   handaan-apps-manifest   the catalogue, as JSON
#   handaan-apps-install    install named apps, here in this terminal
#   handaan-apps-terminal   the same, in a window of its own, logged
#   handaan-apps-mark       record an install without performing one

set -euo pipefail

HANDAAN_PATH="${HANDAAN_PATH:-$HOME/.local/share/handaan}"
# shellcheck source=install/lib/handaan-common.sh
source "$HANDAAN_PATH/install/lib/handaan-common.sh"

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

if (( $# > 0 )); then
    log_error "handaan-apps takes no arguments. To install without the picker:"
    log_error "    handaan apps-install $*"
    exit 1
fi

# qs reports a connection failure with a nonzero exit, but an IPC-level failure
# -- unknown target, unknown function -- on stdout with exit 0, so both have to
# be checked. The two mean different things and have different fixes.
if ! output=$(qs -p "$HANDAAN_PATH/default/quickshell" ipc call appCatalog open 2>/dev/null); then
    log_error "The Quickshell shell is not running, so there is nothing to open."
    log_error "    systemctl --user start quickshell.service"
    exit 1
fi

case $output in
    "Target not found."* | "Function not found."*)
        # The QML type registry is built once at launch, so a shell started
        # before the installer existed cannot see it however current the tree is.
        log_error "This Quickshell session started before the installer existed."
        log_error "    systemctl --user restart quickshell.service"
        exit 1
        ;;
esac
