#!/usr/bin/env bash
# handaan:summary=Install optional applications from your own dotfile repository.
# handaan:args=[APP ... | all]
# handaan:hidden=installs apps, not handaan itself; see docs/standards/core-stays-minimal.md
#
# handaan ships no optional applications of its own -- see
# docs/decisions/adrs/0005-accept-user-owned-optional-applications.md. Every
# app comes from a directory under $HOME/.config/handaan/apps/<name>/,
# supplied by a separate dotfile repository the user owns:
#
#   apps/<name>/meta        handaan:summary=... shown in the selection menu
#   apps/<name>/packages    optional package list, same shape as install/*.packages
#   apps/<name>/install.sh  optional, sourced once when the app is (re)selected
#   apps/<name>/config/     optional, mirrors $HOME, copied in no-clobber
#
# `handaan-update` sources every app's update.sh on its own; see that script.

set -euo pipefail

HANDAAN_PATH="${HANDAAN_PATH:-$HOME/.local/share/handaan}"
# shellcheck source=install/lib/handaan-common.sh
source "$HANDAAN_PATH/install/lib/handaan-common.sh"

readonly APPS_ROOT="$HOME/.config/handaan/apps"

usage() {
    cat <<EOF
Usage: handaan-apps [APP ... | all]

With no arguments, opens a Quickshell selection window listing every app found
under $APPS_ROOT. Pass "all" to install everything found there.

None found yet? Nothing is wrong -- handaan ships no applications of its own.
Add one in your own dotfile repository as $APPS_ROOT/<name>/, then symlink or
copy it into place there, following the convention in
docs/decisions/adrs/0005-accept-user-owned-optional-applications.md.

Account-bound apps are handled separately. They are useless until you sign in,
so they ship as one-shot installers you run by hand after the desktop is up:
  handaan-service-nextcloud     Nextcloud sync client
  handaan-service-todoist       Todoist as a Chromium web app
EOF
}

discover_apps() {
    local dir
    [[ -d $APPS_ROOT ]] || return 0
    for dir in "$APPS_ROOT"/*/; do
        [[ -d $dir ]] || continue
        basename "$dir"
    done | sort
}

app_summary() {
    local meta="$APPS_ROOT/$1/meta"
    [[ -f $meta ]] && sed -n 's/^# handaan:summary=//p' "$meta" | head -1
}

app_exists() {
    [[ -d "$APPS_ROOT/$1" ]]
}

select_apps() {
    local apps=("$@")

    if [[ -z ${WAYLAND_DISPLAY:-} ]] || ! command -v qs &>/dev/null; then
        log_error "handaan-apps needs a running Quickshell session for interactive selection. Pass app names explicitly."
        exit 1
    fi

    local app list_text out_file
    list_text=$(
        for app in "${apps[@]}"; do
            printf '%s\t%s\n' "$app" "$(app_summary "$app")"
        done
    )
    out_file="${XDG_RUNTIME_DIR:-/tmp}/handaan-apps-selection.$$"
    rm -f "$out_file"

    HANDAAN_APPS_LIST="$list_text" HANDAAN_APPS_OUT="$out_file" \
        qs -n -p "$HANDAAN_PATH/default/apps-installer/installer.qml"

    if [[ -s $out_file ]]; then
        # A blank line here would otherwise become one requested app named "",
        # not zero requested apps -- grep it out rather than trust the picker
        # to never emit one.
        grep -v '^$' "$out_file" || true
    fi
    rm -f "$out_file"
}

normalize_apps() {
    local requested=("$@") all_apps name
    mapfile -t all_apps < <(discover_apps)

    if (( ${#requested[@]} == 1 )) && [[ ${requested[0]} == all ]]; then
        printf '%s\n' "${all_apps[@]}"
        return 0
    fi

    local -A seen=()
    for name in "${requested[@]}"; do
        if [[ $name == all ]]; then
            log_error "'all' cannot be combined with other app names." >&2
            return 1
        fi
        if ! app_exists "$name"; then
            log_error "No app found at $APPS_ROOT/$name" >&2
            return 1
        fi
        if [[ -z ${seen[$name]:-} ]]; then
            printf '%s\n' "$name"
            seen[$name]=1
        fi
    done
}

install_app() {
    local name=$1 dir="$APPS_ROOT/$1"

    log_info "Installing $name..."

    if [[ -f "$dir/packages" ]]; then
        yay_install_list "$dir/packages"
    fi

    if [[ -f "$dir/install.sh" ]]; then
        ( source "$dir/install.sh" )
    fi

    if [[ -d "$dir/config" ]]; then
        cp -Rn "$dir"/config/. "$HOME/" 2>/dev/null || true
    fi
}

main() {
    if [[ ${1:-} == -h || ${1:-} == --help ]]; then
        usage
        exit 0
    fi

    local requested=() selected=() all_apps=()
    if (( $# == 0 )); then
        mapfile -t all_apps < <(discover_apps)
        if (( ${#all_apps[@]} == 0 )); then
            log_info "No apps found under $APPS_ROOT."
            usage
            exit 0
        fi
        mapfile -t requested < <(select_apps "${all_apps[@]}")

        if (( ${#requested[@]} == 0 )); then
            log_info "No applications selected; nothing to do."
            exit 0
        fi

        # The picker doesn't assume it was launched from a visible terminal --
        # a future keybind or launcher entry wouldn't have one -- so the
        # actual install runs in a terminal of its own, re-invoking this
        # script with explicit app names to skip straight past the picker.
        # kitty closes it automatically once the install finishes.
        exec kitty --title "Installing applications" \
            -e "$HANDAAN_PATH/bin/handaan-apps" "${requested[@]}"
    fi

    requested=("$@")
    if (( ${#requested[@]} == 0 )); then
        log_info "No applications selected; nothing to do."
        exit 0
    fi

    local normalized
    if ! normalized=$(normalize_apps "${requested[@]}"); then
        exit 1
    fi
    mapfile -t selected <<< "$normalized"

    begin_handaan_install
    install_aur_helper
    upgrade_system

    local app
    for app in "${selected[@]}"; do
        install_app "$app"
    done
    remove_build_dependencies

    log_success "Selected applications installed."
}

main "$@"
