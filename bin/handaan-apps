#!/usr/bin/env bash
# handaan:summary=Install optional applications from your own dotfile repository.
# handaan:args=[APP ... | all | --pending]
# handaan:hidden=installs apps, not handaan itself; see docs/standards/core-stays-minimal.md
#
# handaan ships no optional applications of its own -- see
# docs/decisions/adrs/0005-accept-user-owned-optional-applications.md. Every
# app comes from a directory under $HOME/.config/handaan/apps/<name>/,
# supplied by a separate dotfile repository the user owns:
#
#   apps/<name>/meta        handaan:summary=... shown in the selection menu
#   apps/<name>/packages    optional package list, same shape as install/*.packages
#   apps/<name>/install.sh  optional, sourced once when the app is (re)selected
#   apps/<name>/config/     optional, mirrors $HOME, copied in no-clobber
#
# `handaan-update` sources every app's update.sh on its own; see that script.

set -euo pipefail

HANDAAN_PATH="${HANDAAN_PATH:-$HOME/.local/share/handaan}"
# shellcheck source=install/lib/handaan-common.sh
source "$HANDAAN_PATH/install/lib/handaan-common.sh"

readonly APPS_LOG=/tmp/handaan-apps.log

# Log the install run the way handaan-update logs its own, and for the same
# reason: this script is `set -e`, so any failure ends it immediately, and when
# it was launched from the picker it is running inside a terminal that closes
# with it. Without this the error is gone before it can be read.
#
# Only the run that installs something is wrapped. The picker path re-execs
# into a terminal of its own and that child does its own logging -- wrapping
# the picker instead would capture kitty's stdout, which is not where the
# install's output goes.
#
# -f flushes, -q drops the banner, -e propagates the exit status, and the PTY
# is what keeps pacman's progress bars alive.
if (( $# > 0 )) && [[ $1 != -h && $1 != --help && $1 != --pending && -z ${HANDAAN_APPS_LOGGED:-} ]]; then
    command=$(printf '%q ' "$0" "$@")
    exec env HANDAAN_APPS_LOGGED=1 script -qefc "$command" "$APPS_LOG"
fi

readonly APPS_ROOT="$HOME/.config/handaan/apps"

usage() {
    cat <<EOF
Usage: handaan-apps [APP ... | all | --pending]

With no arguments, opens a Quickshell selection window listing every app found
under $APPS_ROOT. Pass "all" to install everything found there.

--pending lists the apps that are not installed yet, one per line, and does
nothing else. An app counts as installed when every package it declares is;
one that declares none cannot be judged and is always listed.

None found yet? Nothing is wrong -- handaan ships no applications of its own.
Add one in your own dotfile repository as $APPS_ROOT/<name>/, then symlink or
copy it into place there, following the convention in
docs/decisions/adrs/0005-accept-user-owned-optional-applications.md.

Account-bound apps are handled separately. They are useless until you sign in,
so they ship as one-shot installers you run by hand after the desktop is up:
  handaan-service-nextcloud     Nextcloud sync client
  handaan-service-todoist       Todoist as a Chromium web app
EOF
}

discover_apps() {
    local dir
    [[ -d $APPS_ROOT ]] || return 0
    for dir in "$APPS_ROOT"/*/; do
        [[ -d $dir ]] || continue
        basename "$dir"
    done | sort
}

app_summary() {
    local meta="$APPS_ROOT/$1/meta"
    [[ -f $meta ]] && sed -n 's/^# handaan:summary=//p' "$meta" | head -1
}

app_exists() {
    [[ -d "$APPS_ROOT/$1" ]]
}

# One `pacman -Qq` for the whole picker rather than a query per package: the
# app lists together name well over a hundred packages.
declare -A INSTALLED_PKGS=()
load_installed_packages() {
    local pkg
    while read -r pkg; do
        INSTALLED_PKGS[$pkg]=1
    done < <(pacman -Qq 2>/dev/null)
}

# An app counts as installed when every package it declares is installed.
# Apps that declare none -- citrix and steam install theirs from inside
# install.sh -- are unknowable from here and report not-installed rather than
# guessing.
#
# The comment strip matches yay_install_list's, plus a trailing-space trim:
# `s/#.*//` turns "pkg  # why" into "pkg  ", and a trailing space would make
# the lookup miss a package that is in fact installed.
app_installed() {
    local list="$APPS_ROOT/$1/packages" pkg declared=0
    [[ -f $list ]] || return 1
    while read -r pkg; do
        [[ -n $pkg ]] || continue
        declared=1
        [[ -n ${INSTALLED_PKGS[$pkg]:-} ]] || return 1
    done < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' "$list")
    (( declared ))
}

select_apps() {
    local apps=("$@")

    if [[ -z ${WAYLAND_DISPLAY:-} ]] || ! command -v qs &>/dev/null; then
        log_error "handaan-apps needs a running Quickshell session for interactive selection. Pass app names explicitly."
        exit 1
    fi

    local app list_text out_file
    load_installed_packages
    # Third field is the installed flag, which the picker uses to pre-tick the
    # box. Tab-separated like the summary before it, so the QML splits once.
    list_text=$(
        for app in "${apps[@]}"; do
            if app_installed "$app"; then
                printf '%s\t%s\t1\n' "$app" "$(app_summary "$app")"
            else
                printf '%s\t%s\t0\n' "$app" "$(app_summary "$app")"
            fi
        done
    )
    out_file="${XDG_RUNTIME_DIR:-/tmp}/handaan-apps-selection.$$"
    rm -f "$out_file"

    # qs writes every INFO and WARN line to stdout, not stderr -- and this
    # function's stdout *is* the selection, read by `mapfile -t requested`.
    # Left alone, "Launching config: ...", the shell ID and "Configuration
    # Loaded" each arrive as a requested app name, normalize_apps rejects the
    # first one, and the run dies before installing anything.
    #
    # The selection never travels on stdout anyway: the picker writes it to
    # $out_file, which is read below. So send qs's own output to stderr, where
    # it stays visible without being mistaken for data.
    HANDAAN_APPS_LIST="$list_text" HANDAAN_APPS_OUT="$out_file" \
        qs -n -p "$HANDAAN_PATH/default/apps-installer/installer.qml" >&2

    if [[ -s $out_file ]]; then
        # A blank line here would otherwise become one requested app named "",
        # not zero requested apps -- grep it out rather than trust the picker
        # to never emit one.
        grep -v '^$' "$out_file" || true
    fi
    rm -f "$out_file"
}

normalize_apps() {
    local requested=("$@") all_apps name
    mapfile -t all_apps < <(discover_apps)

    if (( ${#requested[@]} == 1 )) && [[ ${requested[0]} == all ]]; then
        printf '%s\n' "${all_apps[@]}"
        return 0
    fi

    local -A seen=()
    for name in "${requested[@]}"; do
        if [[ $name == all ]]; then
            log_error "'all' cannot be combined with other app names." >&2
            return 1
        fi
        if ! app_exists "$name"; then
            log_error "No app found at $APPS_ROOT/$name" >&2
            return 1
        fi
        if [[ -z ${seen[$name]:-} ]]; then
            printf '%s\n' "$name"
            seen[$name]=1
        fi
    done
}

install_app() {
    local name=$1 dir="$APPS_ROOT/$1"

    log_info "Installing $name..."

    if [[ -f "$dir/packages" ]]; then
        yay_install_list "$dir/packages"
    fi

    if [[ -f "$dir/install.sh" ]]; then
        ( source "$dir/install.sh" )
    fi

    if [[ -d "$dir/config" ]]; then
        cp -Rn "$dir"/config/. "$HOME/" 2>/dev/null || true
    fi
}

main() {
    if [[ ${1:-} == -h || ${1:-} == --help ]]; then
        usage
        exit 0
    fi

    # Names only, one per line, for anything that reads this rather than
    # watches it -- the bar's maintenance indicator via handaan-pending, and
    # anyone asking the same question from a terminal. Named after
    # handaan-migrate --pending, which answers the same shape of question.
    # Installs nothing, needs no sudo and no Wayland session.
    if [[ ${1:-} == --pending ]]; then
        local app apps=()
        load_installed_packages
        mapfile -t apps < <(discover_apps)
        for app in "${apps[@]}"; do
            app_installed "$app" || printf '%s\n' "$app"
        done
        exit 0
    fi

    local requested=() selected=() all_apps=()
    if (( $# == 0 )); then
        mapfile -t all_apps < <(discover_apps)
        if (( ${#all_apps[@]} == 0 )); then
            log_info "No apps found under $APPS_ROOT."
            usage
            exit 0
        fi
        mapfile -t requested < <(select_apps "${all_apps[@]}")

        if (( ${#requested[@]} == 0 )); then
            log_info "No applications selected; nothing to do."
            exit 0
        fi

        # The picker doesn't assume it was launched from a visible terminal --
        # a future keybind or launcher entry wouldn't have one -- so the
        # actual install runs in a terminal of its own, re-invoking this
        # script with explicit app names to skip straight past the picker.
        #
        # An `exec` that cannot find its target exits 127 with nothing on
        # screen, which from the picker looks identical to a terminal that
        # opened and vanished. Say which it was.
        if ! command -v kitty &>/dev/null; then
            log_error "kitty is not installed, so the install cannot open a terminal of its own."
            log_error "Run it directly instead:  handaan-apps ${requested[*]}"
            exit 1
        fi

        # kitty closes when its child does. On success that is what should
        # happen; on failure it used to take the error off the screen with it.
        # Hold the window open on a non-zero exit and name the log, so a
        # failure is readable rather than a flash.
        #
        # `status=$?` follows the call directly rather than an `if`: the exit
        # status of an `if` with no else branch is 0 even when its condition
        # failed, which would report every failure as a clean exit.
        exec kitty --title "Installing applications" -e bash -c '
            log=$1; shift
            "$@"
            status=$?
            [ "$status" -eq 0 ] && exit 0
            printf "\n\033[0;31m[FAILED]\033[0m handaan-apps exited %d.\n" "$status"
            printf "Full log: %s\n" "$log"
            printf "\nPress Enter to close this window. "
            read -r _ < /dev/tty
            exit "$status"
        ' _ "$APPS_LOG" "$HANDAAN_PATH/bin/handaan-apps" "${requested[@]}"
    fi

    requested=("$@")
    if (( ${#requested[@]} == 0 )); then
        log_info "No applications selected; nothing to do."
        exit 0
    fi

    local normalized
    if ! normalized=$(normalize_apps "${requested[@]}"); then
        exit 1
    fi
    mapfile -t selected <<< "$normalized"

    begin_handaan_install
    install_aur_helper
    upgrade_system

    local app
    for app in "${selected[@]}"; do
        install_app "$app"
    done
    remove_build_dependencies

    log_success "Selected applications installed. Session log: $APPS_LOG"
}

main "$@"
